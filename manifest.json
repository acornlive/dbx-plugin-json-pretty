{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "chatawesome.cn.json-pretty",
  "name": "JSON 格式化工具",
  "version": "0.1.2",
  "publisher": "acornlive",
  "description": "格式化、压缩、折叠、转义、导入、导出 JSON，左侧工作区树可新建文件夹/JSON 文件。",
  "icon": "assets/json-pretty.svg",
  "engines": {
    "dbx": ">=0.6.23",
    "host_api": "^1.3"
  },
  "permissions": [
    "host.clipboard:read",
    "host.filesystem"
  ],
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    },
    "backend": {
      "executable": "bin/dbx-plugin-json-pretty"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "chatawesome.cn.json-pretty.workbench",
      "label": "JSON 格式化",
      "description": "JSON 格式化工具",
      "icon": "assets/json-pretty.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "JSON 格式化工具",
      "description": "格式化、压缩、折叠、转义、导入、导出 JSON。",
      "contributions": {
        "chatawesome.cn.json-pretty.workbench": {
          "label": "JSON 格式化",
          "description": "JSON 格式化工具"
        }
      }
    }
  }
}
